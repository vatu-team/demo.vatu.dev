{
    "name": "vatu/tools",
    "type": "metapackage",
    "license": "MIT",
    "description": "Development tools.",
    "minimum-stability": "stable",
    "repositories": [
      {
      "type": "vcs",
      "url": "https://github.com/vatu-team/dev-tools.git",
      "only": [
        "vatu/dev-tools"
        ]
      }
    ],
    "require": {
      "slevomat/coding-standard": "^8.19",
      "phpunit/phpunit": "^12.5.9",
      "php-parallel-lint/php-parallel-lint": "^1.4",
      "brain/monkey": "^2.7.0",
      "globtec/phpadr": "^2.0.2",
      "php-stubs/wordpress-stubs": "^6.9.1",
      "php-stubs/wp-cli-stubs": "^2.12",
      "phpcompatibility/phpcompatibility-wp": "^2.1.8",
      "wptrt/wpthemereview": "^0.2.1",
      "yoast/phpunit-polyfills": "^4.0.0",
      "szepeviktor/phpstan-wordpress": "^2.0.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.1.40",
        "squizlabs/php_codesniffer": "^3.13.2",
        "wp-coding-standards/wpcs": "^2.3"
    },
    "config": {
      "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true
        },
        "lock": false,
      "optimize-autoloader": true,
      "preferred-install": "dist",
      "sort-packages": true
    },
    "scripts": {
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.50"
    }
}
